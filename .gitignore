# --- Go ---
/bin/
/dist/
*.exe
*.test
*.out
coverage.*

# --- Python (owner-machine harvest/check scripts; .pyc embeds local paths) ---
__pycache__/
*.pyc

# --- Node (frontend, later milestones) ---
node_modules/
.npm/
*.tsbuildinfo

# --- SQLite databases ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# --- Editor / OS junk ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# testdata/fixtures/** MUST be committed — never add ignore rules for it.
# Re-include in case a broad pattern above ever matches inside fixtures:
!testdata/fixtures/**

# --- Secrets / local-only files (e.g. fixture PROJECT_MAP.local.json) ---
# Must stay BELOW the fixtures re-include: later rules win, and the secret
# map lives inside testdata/fixtures/.
*.local.json
*.local.md

# Full-history ccusage expectations keep REAL session/message ids — owner
# ruling: zero real identifiers anywhere in the committed tree, no
# exemptions. They stay on disk as local point-in-time references only;
# `make parity-full` recaptures from live logs and never reads them.
# Must also stay BELOW the fixtures re-include (later rules win).
testdata/**/expected/*-full.json

# web build (M4 Task 4): sources are committed, artifacts are not —
# leakcheck scans git-visible files, so node_modules/dist must not enter
# its scope (or the tree).
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# --- Codex review scratch ---
# Codex drops a `.codex` at the repo root during a close-review — a 0-byte
# marker file in this version, a scratch dir in others. The bare pattern (no
# trailing slash) ignores both forms so neither shows as untracked.
.codex

# --- Internal docs: kept on the owner's disk, not published ---
# Untracked so they stay local (CLAUDE.md still works as live project
# instructions) without entering the repo. NOTE: this only affects the current
# tip — they remain in git HISTORY, so scrub history before the repo goes public.
/CLAUDE.md
/AGENTS.md
/docs/PRD.md
/docs/milestone-*.md
